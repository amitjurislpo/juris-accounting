# Every variable this site reads. Copy to .env.local for local work; set them in Vercel
# for deployments. With none set, the site still runs and shows its static posts.

# Base URL for canonical links, Open Graph tags and the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.juriscfo.com

# Sanity. The two NEXT_PUBLIC values are built into the Studio, so redeploy after changing them.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional. Defaults to 2025-02-19.
NEXT_PUBLIC_SANITY_API_VERSION=

# Server-only. NEVER prefix with NEXT_PUBLIC_.
# Editor token: used only to send rejected posts back and to delete approved deletions.
SANITY_API_WRITE_TOKEN=
# Viewer token: lets the review page see rejected drafts. Without it the page still works,
# but can't preview them or notice that an author deleted one.
SANITY_API_READ_TOKEN=

# Postgres, for approvals, checkers and admin login. Without it, no Sanity post is ever shown.
# On Neon, the pooled connection. On Supabase, the transaction pooler: port 6543, with ?pgbouncer=true.
DATABASE_URL=
# Optional. Used only by `prisma migrate deploy` on production builds. Needs a direct or
# session connection (Neon direct, Supabase port 5432). If unset, it is derived from DATABASE_URL.
# Set this on Neon: its pooled address can't be derived into a direct one.
DIRECT_URL=

# Local workflow tests only. Never set these on Vercel.
# SANITY_TEST_API_HOST=http://localhost:4599
